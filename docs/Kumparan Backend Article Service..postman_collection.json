    {
      "name": "API 10 — Pagination First Page",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "if (pm.response.code === 200) {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    if (response.next_cursor) {\r",
              "        pm.collectionVariables.set(\r",
              "            \"nextCursor\",\r",
              "            response.next_cursor\r",
              "        );\r",
              "\r",
              "        console.log(\"Next cursor saved\");\r",
              "    } else {\r",
              "        pm.collectionVariables.unset(\"nextCursor\");\r",
              "        console.log(\"No next page available\");\r",
              "    }\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/articles?limit=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "articles"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "API 11 — Pagination Next Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/articles?limit=1&cursor={{nextCursor}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "articles"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1",
              "id": 0
            },
            {
              "key": "cursor",
              "value": "{{nextCursor}}",
              "id": 1
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "API 12 — Update Article",
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"title\": \"Perkembangan Kebijakan Publik Indonesia\",\r\n  \"body\": \"Artikel ini telah diperbarui untuk membahas kebijakan publik, tata kelola pemerintahan, dan transparansi anggaran.\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/articles/{{articleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "articles",
            "{{articleId}}"
          ]
        }
      },
      "response": []
    }
