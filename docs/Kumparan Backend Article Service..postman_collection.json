    {
      "name": "API 09 — Combined Search and Author Filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/articles?query=politik&author={{authorName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "articles"
          ],
          "query": [
            {
              "key": "query",
              "value": "politik"
            },
